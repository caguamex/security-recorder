{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "ritmo/railway/evolution/Dockerfile",
    "watchPatterns": [
      "ritmo/railway/evolution/**"
    ]
  },
  "deploy": {
    "numReplicas": 1,
    "healthcheckPath": "/",
    "healthcheckTimeout": 180,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "sleepApplication": false,
    "overlapSeconds": 0,
    "drainingSeconds": 30
  }
}
